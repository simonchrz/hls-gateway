{
	# Use internal CA for LAN self-signed certs
	local_certs
	# Admin on localhost only
	admin localhost:2019
	# We don't own :80 (pi-hole has it) — disable the auto HTTP→HTTPS redirect
	auto_https disable_redirects
}

# Main HTTPS site with HTTP/2 on port 8443
raspberrypi5lan:8443, raspberrypi5lan.fritz.box:8443, 192.168.178.61:8443 {
	tls internal

	encode zstd gzip

	# Static HLS segments served directly from SSD (bypasses Flask)
	@hls_ts path_regexp ^/hls/[^/]+/seg_[0-9]+\.ts$
	handle @hls_ts {
		root * /mnt/tv
		file_server
		header Content-Type "video/mp2t"
		header Cache-Control "public, max-age=3600"
		header Access-Control-Allow-Origin "*"
	}

	# /imagecache removed 2026-05-29: it was tvh's channel-logo cache on :9981,
	# which no longer exists. tv-receiver has no imagecache; logos come from
	# /static/ch-logos. The tvh-imagecache fallback the gateway still emits for
	# logo-less channels is dead either way (needs a gateway-side fix — see
	# backlog). Requests now fall through to Flask (404) instead of 502 against
	# a dead backend.

	# Recording file stream (tvh-compat, Range support) — tv-receiver on :9983
	# (was tvh :9981, decommissioned 2026-05-27).
	handle /dvrfile/* {
		reverse_proxy 127.0.0.1:9983
	}

	# Static recording segments straight from SSD (bypasses Flask) — mirror of @hls_ts.
	# On disk: /mnt/tv/hls/_rec_<uuid>/seg_NNNNN.ts ; requested as /recording/<uuid>/seg_NNNNN.ts
	# index.m3u8 deliberately NOT matched — stays on Flask (on-demand packaging + ad markers).
	@rec_ts path_regexp recseg ^/recording/([^/]+)/(seg_[0-9]+\.ts)$
	handle @rec_ts {
		rewrite * /hls/_rec_{re.recseg.1}/{re.recseg.2}
		root * /mnt/tv
		file_server
		header Content-Type "video/mp2t"
		header Cache-Control "public, max-age=3600"
		header Access-Control-Allow-Origin "*"
	}

	# Everything else → Flask gateway
	reverse_proxy 127.0.0.1:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}

# Plain HTTP :8444 → redirect to HTTPS (easy backup port)
# optional — falls wir mal HTTP→HTTPS-Redirect wollen
:8444 {
	redir https://{host}:8443{uri} permanent
}
